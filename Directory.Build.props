<Project>
  <PropertyGroup>
    <Authors>Richard Sperry</Authors>
    <Company>Sperry</Company>
    <Product>SperryDev.Logger</Product>
    <Copyright>Copyright (c) Richard Sperry</Copyright>
    <PackageLicenseExpression>UNLICENSED</PackageLicenseExpression>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SignAssembly Condition="Exists('$(MSBuildThisFileDirectory)SperryDev.Logger.snk')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('$(MSBuildThisFileDirectory)SperryDev.Logger.snk')">$(MSBuildThisFileDirectory)SperryDev.Logger.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
</Project>
